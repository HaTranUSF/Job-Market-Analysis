# Copy to .env and fill in your private credentials. Never commit .env.
USAJOBS_USER_AGENT=your-contact-email-or-application-name
USAJOBS_AUTH_KEY=your-usajobs-api-key

DB_USER=your-postgres-user
DB_PASSWORD=your-postgres-password
DB_HOST=localhost
DB_PORT=5432
DB_NAME=job_market

# Optional GenAI risk-evidence enrichment 
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.8-flash

# Optional Databricks deployment settings
DATABRICKS_HOST=https://<your-workspace>.cloud.databricks.com
DATABRICKS_TOKEN=your-databricks-token
DATABRICKS_CATALOG=main
